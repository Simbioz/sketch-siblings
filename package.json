{
  "name": "sketch-siblings",
  "version": "1.1.0",
  "engines": {
    "sketch": ">=3.0"
  },
  "skpm": {
    "name": "Siblings",
    "manifest": "src/manifest.json",
    "main": "sketch-siblings.sketchplugin",
    "assets": [
      "assets/**/*"
    ]
  },
  "scripts": {
    "build": "skpm-build",
    "lint": "eslint src eslint.config.mjs",
    "watch": "skpm-build --watch",
    "start": "skpm-build --watch --run",
    "postinstall": "npm run build && skpm-link"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@skpm/builder": "^0.9.5",
    "eslint": "^10.1.0"
  },
  "author": "Michaël Fortin <michael@irradiated.net>",
  "dependencies": {
    "lodash-es": "^4.17.23"
  }
}
